# Copy to .env.local (git-ignored) or run `vercel env pull .env.local`.
# Pooled connection for app code and functions.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct connection for migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Written by `neon env pull` for the linked branch (also injected into Neon Functions).
NEON_BRANCH=dev
NEON_AUTH_BASE_URL=https://ep-example.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-example.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Function env declared in neon.ts (uploaded by `neon deploy --env .env.local`).
ALLOWED_ORIGINS=http://localhost:4200
# First sign-in with this email becomes owner of the studio below. Clear once granted.
BOOTSTRAP_OWNER_EMAIL=you@example.com
BOOTSTRAP_STUDIO_SLUG=demo-studio

# Local test account used by e2e and manual checks (create it via the sign-up form).
E2E_OWNER_EMAIL=owner@studiohouse.test
E2E_OWNER_PASSWORD=change-me
