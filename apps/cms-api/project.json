{
  "name": "cms-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cms-api/src",
  "projectType": "library",
  "tags": ["scope:api"],
  "// targets": "to see all targets run: nx show project cms-api --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p apps/cms-api/tsconfig.lib.json --noEmit",
          "tsc -p apps/cms-api/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["default", "^default"]
    }
  }
}
